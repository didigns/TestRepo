{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwnYourPC",
  "version": "0.1.0",
  "identifier": "com.ownyourpc.app",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OwnYourPC",
        "width": 1040,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "url": "http://127.0.0.1:8756"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
