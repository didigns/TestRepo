{
  "manifestVersion": 1,
  "id": "novel-maker",
  "name": "인터랙티브 소설 메이커",
  "version": "1.0.0",
  "author": "AISummary",
  "description": "자기만의 분기형 인터랙티브 소설을 만드는 저작 도구. AI 초안 + 노드 편집 + 스탯/상태창 + 미리보기 + 플러그인으로 내보내기. (T2 WASM 코드 플러그인)",
  "entry": "plugin.wasm",
  "permissions": {
    "folders": [],
    "network": false,
    "capabilities": ["code:wasm", "model:generate", "ui:render", "storage:local"]
  },
  "contributes": {
    "mode": {
      "label": "소설 메이커",
      "icon": "📖"
    }
  }
}
